<div class="ta-art">
    <div class="ta-art__glow" aria-hidden="true"></div>

    <div class="ta-art__clock-wrap">
        <div class="ta-clock" id="taClock">
            <svg viewBox="0 0 200 200" class="ta-clock__svg" aria-hidden="true">
                <defs>
                    <radialGradient id="clockFace" cx="50%" cy="42%" r="60%">
                        <stop offset="0%" stop-color="var(--surface)"/>
                        <stop offset="100%" stop-color="var(--bg-2)"/>
                    </radialGradient>
                </defs>
                <circle cx="100" cy="100" r="96" fill="url(#clockFace)" stroke="var(--line)" stroke-width="1"/>
                <circle cx="100" cy="100" r="96" fill="none" stroke="var(--accent)" stroke-opacity=".18" stroke-width="2"/>
                <g style="color: var(--ink)">
                    {% for i in 0..59 %}
                        {% set big = i % 5 == 0 %}
                        <line x1="100" y1="{{ big ? 12 : 15 }}" x2="100" y2="{{ big ? 22 : 18 }}"
                              stroke="currentColor" stroke-opacity="{{ big ? '.85' : '.25' }}"
                              stroke-width="{{ big ? 2 : 1 }}" stroke-linecap="round"
                              transform="rotate({{ i * 6 }} 100 100)"/>
                    {% endfor %}
                </g>

                <text x="100" y="38" text-anchor="middle" fill="var(--ink-2)" font-size="13" font-family="Geist Mono, ui-monospace, monospace" font-weight="500">12</text>
                <text x="162" y="105" text-anchor="middle" fill="var(--ink-2)" font-size="13" font-family="Geist Mono, ui-monospace, monospace" font-weight="500">3</text>
                <text x="100" y="170" text-anchor="middle" fill="var(--ink-2)" font-size="13" font-family="Geist Mono, ui-monospace, monospace" font-weight="500">6</text>
                <text x="38" y="105" text-anchor="middle" fill="var(--ink-2)" font-size="13" font-family="Geist Mono, ui-monospace, monospace" font-weight="500">9</text>

                <line id="taClockHour" x1="100" y1="100" x2="100" y2="58"
                      stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
                <line id="taClockMin" x1="100" y1="100" x2="100" y2="40"
                      stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round"/>
                <g id="taClockSec">
                    <line x1="100" y1="115" x2="100" y2="30"
                          stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round"/>
                    <circle cx="100" cy="30" r="3" fill="var(--accent)"/>
                </g>
                <circle cx="100" cy="100" r="4.5" fill="var(--ink)"/>
                <circle cx="100" cy="100" r="1.5" fill="var(--surface)"/>
            </svg>
            <div class="ta-clock__caption mono">
                <span id="taClockDow"></span>
                <span id="taClockDate"></span>
            </div>
        </div>
    </div>

    <div class="ta-art__timer-wrap">
        <button type="button" class="ta-livetimer" id="taTimer" aria-label="Pause tracking">
            <span class="ta-dot is-on" id="taTimerDot"></span>
            <span class="ta-livetimer__label" id="taTimerLabel">Tracking</span>
            <span class="ta-livetimer__sep"></span>
            <span class="mono ta-livetimer__time" id="taTimerTime">02:14:36</span>
            <span class="ta-livetimer__project mono">· DESIGN-204</span>
        </button>
    </div>

    <div class="ta-art__cal-wrap">
        {% include 'home/_calendar.html.twig' %}
    </div>
</div>
