<aside class="app-sidebar" id="appSidebar">
    <div class="sidebar-logo">
        <div class="sidebar-logo-mark">T</div>
        <span class="sidebar-logo-text">Takt</span>
    </div>

    <nav class="sidebar-nav">
        {% if is_granted('ROLE_ADMIN') %}
        <div class="sidebar-section">
            <span class="sidebar-section-label">Admin</span>
        </div>
        <a href="{{ path('app_admin_stats') }}"
           class="sidebar-item {{ app.request.attributes.get('_route') == 'app_admin_stats' ? 'active' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            Overview
        </a>
        <a href="{{ path('sonata_admin_dashboard') }}" class="sidebar-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            Admin Panel
        </a>
        {% endif %}

        {% if is_granted('ROLE_MANAGER') %}
        <div class="sidebar-section">
            <span class="sidebar-section-label">Manage</span>
        </div>
        <a href="{{ path('app_manager_dashboard') }}"
           class="sidebar-item {{ app.request.attributes.get('_route') starts with 'app_manager_dashboard' ? 'active' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Team Dashboard
        </a>
        <a href="{{ path('app_manager_vacations') }}"
           class="sidebar-item {{ app.request.attributes.get('_route') == 'app_manager_vacations' ? 'active' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            Vacation Requests
        </a>
        {% endif %}

        {% if is_granted('ROLE_EMPLOYEE') %}
        <div class="sidebar-section">
            <span class="sidebar-section-label">My Work</span>
        </div>
        <a href="{{ path('app_time_entry_index') }}"
           class="sidebar-item {{ app.request.attributes.get('_route') in ['app_time_entry_index', 'app_time_entry_log'] ? 'active' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            My Time
        </a>
        <a href="{{ path('app_time_entry_summary') }}"
           class="sidebar-item {{ app.request.attributes.get('_route') == 'app_time_entry_summary' ? 'active' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Monthly Summary
        </a>
        <a href="{{ path('app_vacation_index') }}"
           class="sidebar-item {{ app.request.attributes.get('_route') in ['app_vacation_index', 'app_vacation_request'] ? 'active' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 3l-4 4-4-4"/></svg>
            My Vacations
        </a>
        <a href="{{ path('app_calendar') }}"
           class="sidebar-item {{ app.request.attributes.get('_route') == 'app_calendar' ? 'active' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><circle cx="12" cy="16" r="1.2" fill="currentColor" stroke="none"/></svg>
            Calendar
        </a>
        {% endif %}
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="sidebar-avatar">
                {{ (app.user.fullName ?? app.user.userIdentifier)|slice(0,1)|upper }}
            </div>
            <div class="sidebar-user-info">
                <div class="sidebar-user-name">{{ app.user.fullName ?? app.user.userIdentifier }}</div>
                <div class="sidebar-user-role">
                    {% if is_granted('ROLE_SUPER_ADMIN') %}Super Admin
                    {% elseif is_granted('ROLE_ADMIN') %}Admin
                    {% elseif is_granted('ROLE_MANAGER') %}Manager
                    {% else %}Employee{% endif %}
                </div>
            </div>
            <a href="{{ path('app_logout') }}" class="btn-ghost btn btn-sm" title="Sign out">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </a>
        </div>
    </div>
</aside>
