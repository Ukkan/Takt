<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Takt — Time &amp; holidays, in rhythm</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/landing.css') }}">
    <script>
        (function () {
            var stored = localStorage.getItem('theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.dataset.theme = stored || (prefersDark ? 'dark' : 'light');
        })();
    </script>
</head>
<body>
<div class="ta-shell">
    <div class="ta-bg" aria-hidden="true"></div>
    <div class="ta-grid-bg" aria-hidden="true"></div>

    <header class="ta-container ta-nav">
        <a class="ta-brand" href="{{ path('app_landing') }}" aria-label="Takt — home">
            <span class="ta-brand__mark">
                <svg width="34" height="34" viewBox="0 0 26 26" aria-hidden="true">
                    <circle cx="13" cy="13" r="11.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-opacity=".85"/>
                    <rect x="11.7" y="3" width="2.6" height="6" rx="1.3" fill="var(--accent)"/>
                    <circle cx="13" cy="13" r="1.7" fill="currentColor"/>
                </svg>
            </span>
            <span class="ta-brand__word">takt</span>
        </a>

        <div class="ta-nav__right">
            <nav class="ta-nav__links" aria-label="Primary">
                <a class="ta-nav__link" data-hide-sm href="#product">Product</a>
                <a class="ta-nav__link" data-hide-sm href="#why">For HR</a>
                <a class="ta-nav__link" data-hide-sm href="#security">Security</a>
                <a class="ta-nav__link" data-hide-sm href="#pricing">Pricing</a>
                <a class="ta-nav__link" href="{{ path('app_login') }}">Sign in</a>
            </nav>
            <button class="ta-nav__cta" type="button" data-modal-open>Start using now</button>
        </div>
    </header>

    <main class="ta-container ta-hero">
        <section class="ta-hero__left">
            <span class="ta-eyebrow">
                <span class="ta-eyebrow__pip"></span>
                New
                <span class="ta-eyebrow__sep"></span>
                <span class="mono">REGION-AWARE PTO FOR 47 COUNTRIES</span>
            </span>

            <h1 class="ta-headline">
                Time and holidays,<br>
                <em>in rhythm.</em>
            </h1>

            <p class="ta-sub">Takt keeps every hour, day off, and timesheet across your company on the same beat. One workspace for tracking, approvals, and the calendar everyone trusts. Built for HR teams that take both compliance and Fridays seriously.</p>

            <div class="ta-cta-row">
                <button class="ta-btn ta-btn--primary ta-btn--lg" type="button" data-modal-open>
                    Start using now
                    <span class="ta-cta-arrow" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 14 14">
                            <path d="M2 7H12M8 3L12 7L8 11" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </button>
                <a class="ta-btn ta-btn--ghost ta-btn--lg" href="#github">
                    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" style="margin-right: 2px">
                        <path fill="currentColor" d="M8 .5C3.58.5 0 4.08 0 8.5c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.34c-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82A7.6 7.6 0 0 1 8 4.32c.68 0 1.36.09 2 .27 1.52-1.03 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.28.82 2.15 0 3.07-1.87 3.74-3.65 3.94.29.25.54.74.54 1.49v2.21c0 .22.15.46.55.38A8.01 8.01 0 0 0 16 8.5C16 4.08 12.42.5 8 .5Z"/>
                    </svg>
                    Self-host on GitHub
                    <span class="mono ta-star">★ 2.3k</span>
                </a>
            </div>

            <div class="ta-fineprint">
                <span class="mono" style="color: var(--ink-2)">MIT</span>
                <span>Open source · self-host free, or use hosted SaaS</span>
                <span class="dot"></span>
                <span class="mono">SOC 2 · GDPR · ISO 27001</span>
            </div>
        </section>

        <section class="ta-hero__right" aria-label="Live product preview">
            {% include 'home/_hero_art.html.twig' %}
        </section>
    </main>

    <footer class="ta-container ta-foot">
        <div class="ta-foot__col">
            <span style="color: var(--ink-2)">© 2026 Takt sp. z&nbsp;o.o.</span>
            <span class="dot"></span>
            <span class="mono">v2026.05 · Elbląg, Poland</span>
        </div>
        <div class="ta-foot__col">
            <a class="ta-nav__link" href="#privacy" style="padding: 4px 8px">Privacy</a>
            <a class="ta-nav__link" href="#terms" style="padding: 4px 8px">Terms</a>
            <a class="ta-nav__link" href="#docs" style="padding: 4px 8px">Docs</a>
        </div>
    </footer>
</div>

{% include 'home/_signup_modal.html.twig' %}

<script src="{{ asset('js/landing.js') }}" defer></script>
</body>
</html>
